{
  "kind": "collectionType",
  "collectionName": "shop_offers",
  "info": {
    "singularName": "shop-offer",
    "pluralName": "shop-offers",
    "displayName": "Shop Offer",
    "description": "Shopping offers and promotions"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "discount": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "detail": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "termsAndConditions": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "merchant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::merchant.merchant",
      "inversedBy": "offers",
      "description": "Merchant associated with this offer"
    },
    "relatedBlogPosts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "relatedOffers"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::shop-offer-category.shop-offer-category",
      "inversedBy": "offers",
      "description": "Multiple categories; add new Shop Offer Category entries to extend the list"
    },
    "channel": {
      "type": "enumeration",
      "enum": ["online", "retail", "all"],
      "default": "all",
      "description": "Where the offer applies: online only, retail only, or both"
    },
    "merchantWebsite": {
      "type": "string"
    },
    "creditCardSlug": {
      "type": "customField",
      "customField": "global::credit-card-slugs",
      "description": "Comma-separated credit card slugs (with autocomplete)"
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "isRecommended": {
      "type": "boolean",
      "default": false,
      "description": "Recommendation checkbox (curated offers)"
    },
    "viewCount": {
      "type": "integer",
      "default": 0
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "credit_cards",
  "info": {
    "singularName": "credit-card",
    "pluralName": "credit-cards",
    "displayName": "Credit Card",
    "description": "Credit card slugs managed with external API autocomplete"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slugsCsv": {
      "type": "customField",
      "customField": "global::credit-card-slugs",
      "required": true,
      "description": "Comma-separated credit card slugs, e.g. hsbc-red,scb-smart",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "description": "General description for this credit card",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "credit-card.tag-pill",
      "min": 0,
      "max": 32,
      "description": "Tag cloud: short labels shown as pills (e.g. Cashback, Lounge)",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "informationalTags": {
      "type": "component",
      "repeatable": true,
      "component": "credit-card.informational-tag",
      "min": 0,
      "max": 24,
      "description": "Informational tags: short lines (e.g. disclaimers, badges, footnotes)",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cardFaceImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Card face image",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "keyMetrics": {
      "type": "component",
      "repeatable": true,
      "component": "credit-card.key-metric",
      "min": 0,
      "max": 12,
      "description": "key metrics: icon, main text, and label each",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "staticContents": {
      "type": "component",
      "repeatable": false,
      "component": "credit-card.static-contents",
      "description": "Static content section: benefits, fees, eligibility, issuer, and payment details",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "offerDetails": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "offerUrl": {
      "type": "string",
      "description": "Link to the welcome offer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}

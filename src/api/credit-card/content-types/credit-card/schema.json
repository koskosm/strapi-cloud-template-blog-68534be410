{
  "kind": "collectionType",
  "collectionName": "credit_cards",
  "info": {
    "singularName": "credit-card",
    "pluralName": "credit-cards",
    "displayName": "Credit Card",
    "description": "Credit card slugs managed with external API autocomplete"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slugsCsv": {
      "type": "customField",
      "customField": "global::credit-card-slugs",
      "required": true,
      "description": "Comma-separated credit card slugs, e.g. hsbc-red,scb-smart",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "description": "General description for this credit card",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cardFaceImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "description": "Card face image",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "topMetricsLabel1": {
      "type": "string",
      "description": "Top metrics label 1",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topMetricsValue1": {
      "type": "string",
      "description": "Top metrics value 1",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topMetricsLabel2": {
      "type": "string",
      "description": "Top metrics label 2",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topMetricsValue2": {
      "type": "string",
      "description": "Top metrics value 2",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topMetricsLabel3": {
      "type": "string",
      "description": "Top metrics label 3",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "topMetricsValue3": {
      "type": "string",
      "description": "Top metrics value 3",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "keyMetrics": {
      "type": "component",
      "repeatable": true,
      "component": "credit-card.key-metric",
      "min": 0,
      "max": 12,
      "description": "key metrics: icon, main text, and label each"
    },
    "offerDetails": {
      "type": "customField",
      "customField": "plugin::ckeditor.CKEditor",
      "options": {
        "preset": "standard",
        "output": "HTML"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "offerUrl": {
      "type": "string",
      "description": "Link to the welcome offer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
